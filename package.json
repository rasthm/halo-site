{
  "name": "halo-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3020",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview --port=3020",
    "lint": "tsc --noEmit && tsc --noEmit -p worker",
    "shots": "node scripts/shots.mjs",
    "deploy": "npm run lint && npm run build && wrangler deploy"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.0.4",
    "opentype.js": "^1.3.4",
    "puppeteer-core": "^24.10.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.6",
    "wawoff2": "^2.0.1",
    "wrangler": "^4.164.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261117.1": true
  }
}
